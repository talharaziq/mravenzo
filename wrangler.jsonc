{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pawpawdecors",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "talharaziq@outlook.com",
      "allowed_sender_addresses": [
        "contact@pawpawdecors.com"
      ],
      "remote": true
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "2026111301",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
