---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CategoryCard from '@/components/CategoryCard.astro';
import { interiorCategories, exteriorCategories } from '@/data/categories';
import { site } from '@/data/site';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Home, Garden & Plant Topics',
  description: 'Browse home decor, garden decor and plant-care topics at PawpawDecors.',
  url: `${site.url}/categories/`,
};
---
<BaseLayout
  title="Explore Home, Garden & Plant Topics | PawpawDecors"
  description="Browse PawpawDecors topics for home styling, bedrooms, kitchens, balconies, garden decor, outdoor living and plant care."
  structuredData={structuredData}
>
  <section class="page-shell container">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Explore topics' }]} />
    <header class="archive-intro">
      <span class="eyebrow">A place to begin</span>
      <h1>Explore topics.</h1>
      <p>Choose a room, a corner outside or a plant you would like to know better. Each topic brings related guides and ideas together.</p>
    </header>
    <div class="category-group">
      <h2 class="category-group-title">Interior decor <span>01 — 04</span></h2>
      <div class="topics-grid">{interiorCategories.map((category, index) => <CategoryCard category={category} number={String(index + 1).padStart(2, '0')} />)}</div>
    </div>
    <div class="category-group">
      <h2 class="category-group-title">Garden & outdoor <span>05 — 08</span></h2>
      <div class="topics-grid">{exteriorCategories.map((category, index) => <CategoryCard category={category} number={String(index + 5).padStart(2, '0')} />)}</div>
    </div>
  </section>
</BaseLayout>
