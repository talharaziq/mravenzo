---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
---
<BaseLayout title="Page not found | PawpawDecors" description="The page you are looking for could not be found." robots="noindex,follow">
  <section class="text-page" style="min-height: 58vh; display: grid; align-content: center;">
    <span class="eyebrow">404 — A little detour</span>
    <h1>This page has wandered off.</h1>
    <p class="page-lede">The address may have changed, or the page may no longer be here. You can return to the homepage or browse the article library.</p>
    <div class="hero-actions"><a class="button" href="/">Back home <Icon name="arrow-right" size={16} /></a><a class="button button-outline" href="/articles/">Browse articles</a></div>
  </section>
</BaseLayout>
