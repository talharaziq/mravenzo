---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import EmptyState from '@/components/EmptyState.astro';
import Pagination from '@/components/Pagination.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { exteriorCategories } from '@/data/categories';
import { getPublishedArticles, belongsToGroup } from '@/utils/content';
import { site } from '@/data/site';

const pageSize = 12;
const articles = (await getPublishedArticles()).filter((article) => belongsToGroup(article, 'exterior'));
const totalPages = Math.max(1, Math.ceil(articles.length / pageSize));
const pageArticles = articles.slice(0, pageSize);
const description = 'Find garden decor, plant care and outdoor living ideas for patios, decks, lighting, front yards and greener spaces.';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Garden & Outdoor Ideas',
  description,
  url: `${site.url}/exterior-decor/`,
};
---
<BaseLayout title="Garden & Outdoor Decor Ideas | PawpawDecors" description={description} structuredData={structuredData}>
  <section class="page-shell container">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Garden & Outdoor' }]} />
    <header class="archive-intro">
      <span class="eyebrow">Beyond the walls</span>
      <h1>Make the outdoors yours.</h1>
      <p>From a balcony garden to a welcoming front yard, find planting, outdoor styling and practical ideas for the spaces where you get some fresh air.</p>
    </header>
    <div class="category-quick-links">{exteriorCategories.map((category) => <a href={`/category/${category.slug}/`}>{category.title}</a>)}</div>
    <div class="archive-tools"><span class="archive-count">{articles.length} outdoor {articles.length === 1 ? 'article' : 'articles'}</span><span class="archive-count">12 articles per page</span></div>
    {pageArticles.length > 0 ? <div class="archive-grid">{pageArticles.map((article) => <ArticleCard article={article} />)}</div> : <EmptyState title="No garden or outdoor articles yet" text="Browse all articles for more home, garden and plant inspiration." />}
    <Pagination current={1} total={totalPages} basePath="/exterior-decor/" />
  </section>
</BaseLayout>
