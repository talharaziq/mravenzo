---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Icon from '@/components/Icon.astro';
import { getPublishedPages } from '@/utils/content';
import { site } from '@/data/site';

const socialProfiles = [
  'https://www.linkedin.com/in/talharaziq',
  'https://x.com/talha_raziq',
  'https://www.instagram.com/raayzik/',
];

export async function getStaticPaths() {
  const pages = await getPublishedPages();
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const pageTitle = page.data.seo?.title || page.data.title;
const description = page.data.seo?.description || page.data.description || site.description;
const canonical = page.data.seo?.canonicalUrl || undefined;
const socialImage = page.data.seo?.ogImage || site.defaultOgImage;
const socialAlt = page.data.seo?.ogImageAlt || page.data.title;
const isAuthor = page.id === 'author';
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: 'About Talha Raziq',
  url: `${site.url}/author/`,
  mainEntity: {
    '@type': 'Person',
    name: site.author,
    url: `${site.url}/author/`,
    jobTitle: 'Founder and author of PawpawDecors',
    description: 'A plant enthusiast with a biotechnology background and research experience in plant biotechnology.',
    sameAs: socialProfiles,
  },
};
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': page.data.seo?.schemaType || 'WebPage',
  name: page.data.title,
  description,
  url: `${site.url}/${page.id}/`,
  isPartOf: { '@type': 'WebSite', name: site.name, url: site.url },
};
const robots = `${page.data.seo?.index === false ? 'noindex' : 'index'},${page.data.seo?.follow === false ? 'nofollow' : 'follow'},max-image-preview:large`;
---
<BaseLayout
  title={`${pageTitle} | ${site.name}`}
  description={description}
  canonical={canonical}
  image={socialImage}
  imageAlt={socialAlt}
  ogTitle={page.data.seo?.ogTitle || pageTitle}
  ogDescription={page.data.seo?.ogDescription || description}
  twitterCard={page.data.seo?.twitterCard || 'summary_large_image'}
  twitterTitle={page.data.seo?.twitterTitle || page.data.seo?.ogTitle || pageTitle}
  twitterDescription={page.data.seo?.twitterDescription || page.data.seo?.ogDescription || description}
  twitterImage={page.data.seo?.twitterImage || socialImage}
  robots={robots}
  structuredData={isAuthor ? personSchema : pageSchema}
>
  <section class="text-page">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: page.data.title }]} />
    <span class="eyebrow">{site.name}</span>
    <h1>{page.data.title}</h1>
    {page.data.description && <p class="page-lede">{page.data.description}</p>}
    <div class="text-page-body"><Content /></div>
    {isAuthor && (
      <nav class="author-links" aria-label="Talha Raziq links">
        <a href="https://www.linkedin.com/in/talharaziq" target="_blank" rel="me noopener noreferrer">LinkedIn</a>
        <a href="https://x.com/talha_raziq" target="_blank" rel="me noopener noreferrer">X</a>
        <a href="https://www.instagram.com/raayzik/" target="_blank" rel="me noopener noreferrer">Instagram</a>
        <a href={`mailto:${site.contactEmail}`}>Email</a>
      </nav>
    )}
    {page.id === 'contact' && (
      <div class="contact-details">
        <a class="button contact-email-button" href={`mailto:${site.contactEmail}`} aria-label="Email PawpawDecors">
          <Icon name="mail" size={17} /> Email PawpawDecors <span aria-hidden="true">↗</span>
        </a>
      </div>
    )}
  </section>
</BaseLayout>
