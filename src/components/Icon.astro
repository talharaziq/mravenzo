---
const { name = 'leaf', size = 22, strokeWidth = 1.7 } = Astro.props as { name?: string; size?: number; strokeWidth?: number };
---
<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'bed' && <><path d="M3 18v-5a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v5"/><path d="M3 14h18M5 10V6a2 2 0 0 1 2-2h3v6M14 10V4h3a2 2 0 0 1 2 2v4M3 18v2m18-2v2"/></>}
  {name === 'cooking-pot' && <><path d="M4 10h16l-1.2 9H5.2L4 10Z"/><path d="M3 10h18M9 6h6M12 6V3M7 10V8m10 2V8M9 14h6"/></>}
  {name === 'sofa' && <><path d="M4 11V8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v3"/><path d="M3 12a2 2 0 0 1 2 2v3h14v-3a2 2 0 0 1 2-2v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-5Z"/><path d="M7 17v3m10-3v3"/></>}
  {name === 'sun' && <><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></>}
  {name === 'flower-2' && <><path d="M12 12c-3-2-3-5-1-7 2 2 2 5 1 7Zm0 0c2-3 5-3 7-1-2 2-5 2-7 1Zm0 0c3 2 3 5 1 7-2-2-2-5-1-7Zm0 0c-2 3-5 3-7 1 2-2 5-2 7-1Z"/><circle cx="12" cy="12" r="2"/><path d="M12 14v8m0-4c-2-2-4-2-5-1"/></>}
  {name === 'armchair' && <><path d="M7 11V6a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v5"/><path d="M5 10a2 2 0 0 0-2 2v5h18v-5a2 2 0 0 0-2-2h-1v5H6v-5H5Z"/><path d="M6 17v4m12-4v4"/></>}
  {name === 'lamp' && <><path d="M8 3h8l3 8H5l3-8Z"/><path d="M12 11v8m-4 2h8m-4-2v2"/><path d="M9 6h6"/></>}
  {name === 'house' && <><path d="m3 10 9-7 9 7"/><path d="M5 9v12h14V9M9 21v-7h6v7"/></>}
  {name === 'search' && <><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></>}
  {name === 'moon' && <path d="M20.5 15.5A8.5 8.5 0 0 1 8.5 3.5 8.5 8.5 0 1 0 20.5 15.5Z"/>}
  {name === 'sunny' && <><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></>}
  {name === 'arrow-right' && <><path d="M4 12h15m-6-6 6 6-6 6"/></>}
  {name === 'arrow-up-right' && <><path d="M7 17 17 7M7 7h10v10"/></>}
  {name === 'leaf' && <><path d="M20 4c-7 0-13 2-15 8-1 3 1 7 5 7 6 0 10-7 10-15Z"/><path d="M5 19c3-4 7-7 12-10"/></>}
  {name === 'menu' && <><path d="M4 7h16M4 12h16M4 17h16"/></>}
  {name === 'close' && <><path d="m6 6 12 12M18 6 6 18"/></>}
  {name === 'clock' && <><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></>}
  {name === 'calendar' && <><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></>}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></>}
</svg>
