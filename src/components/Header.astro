---
import Icon from './Icon.astro';
import { interiorCategories, exteriorCategories } from '@/data/categories';
const path = Astro.url.pathname;
const homeActive = path === '/';
const articlesActive = path.startsWith('/articles/');
const interiorActive = path.startsWith('/interior-decor/') || interiorCategories.some((item) => path.startsWith(`/category/${item.slug}/`));
const exteriorActive = path.startsWith('/exterior-decor/') || exteriorCategories.some((item) => path.startsWith(`/category/${item.slug}/`));
const aboutActive = path === '/about/';
---
<header class="site-header">
  <div class="header-inner">
    <button class="mobile-menu-toggle icon-button" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-navigation" data-menu-toggle>
      <Icon name="menu" size={21} />
    </button>
    <nav class="main-nav" id="primary-navigation" aria-label="Main navigation">
      <a class:list={['nav-link', { active: homeActive }]} href="/">Home</a>
      <a class:list={['nav-link', { active: articlesActive }]} href="/articles/">Articles</a>
      <div class:list={['nav-dropdown', { active: interiorActive }]}>
        <a class:list={['nav-link', { active: interiorActive }]} href="/interior-decor/" aria-haspopup="true">Interior Decor</a>
        <div class="dropdown-panel">
          <span class="dropdown-heading">Inside the home</span>
          {interiorCategories.map((category) => <a href={`/category/${category.slug}/`}>{category.title}</a>)}
        </div>
      </div>
      <div class:list={['nav-dropdown', { active: exteriorActive }]}>
        <a class:list={['nav-link', { active: exteriorActive }]} href="/exterior-decor/" aria-haspopup="true">Garden & Outdoor</a>
        <div class="dropdown-panel">
          <span class="dropdown-heading">Beyond the walls</span>
          {exteriorCategories.map((category) => <a href={`/category/${category.slug}/`}>{category.title}</a>)}
        </div>
      </div>
      <a class:list={['nav-link', { active: aboutActive }]} href="/about/">About</a>
    </nav>
    <div class="header-actions">
      <button class="icon-button search-toggle" type="button" aria-label="Open search" aria-expanded="false" aria-controls="header-search" data-search-toggle>
        <Icon name="search" size={20} />
      </button>
      <button class="icon-button theme-toggle" type="button" aria-label="Switch to dark theme" data-theme-toggle>
        <span class="theme-icon-light"><Icon name="moon" size={19} /></span>
        <span class="theme-icon-dark"><Icon name="sunny" size={19} /></span>
      </button>
    </div>
    <a class="brand" href="/" aria-label="PawpawDecors home"><span class="brand-paw" aria-hidden="true">🐾</span><span class="brand-name">pawpawdecors</span></a>
  </div>
  <div class="header-search" id="header-search" hidden>
    <form action="/search/" method="get" role="search">
      <Icon name="search" size={19} />
      <input type="search" name="q" placeholder="Search articles and topics…" aria-label="Search articles and topics" />
      <button type="submit">Search</button>
    </form>
    <p>Find ideas for your rooms, garden and plants.</p>
  </div>
</header>
