---
import Icon from './Icon.astro';
import { articleUrl, getArticleCategories } from '@/utils/content';
const { article, variant = 'standard' } = Astro.props;
const category = getArticleCategories(article)[0];
const image = article.data.featuredImage;
const imageAlt = article.data.featuredImageAlt || article.data.title;
const description = article.data.excerpt || article.data.seo?.description || '';
const url = articleUrl(article);
---
{variant === 'featured' ? (
  <article class="featured-slide">
    <a class="featured-slide-image" href={url} aria-label={`Read ${article.data.title}`}>
      {image ? <img src={image} alt={imageAlt} width="1200" height="900" loading="lazy" decoding="async" /> : <span class="featured-image-fallback" aria-hidden="true">🌿</span>}
    </a>
    <div class="featured-slide-copy">
      <span class="eyebrow">{category?.title || 'From the journal'}</span>
      <h3><a href={url}>{article.data.title}</a></h3>
      <p>{description}</p>
      <a class="featured-read-link" href={url}>Read the story <Icon name="arrow-right" size={17} /></a>
    </div>
  </article>
) : (
  <article class="article-card article-card--compact">
    <a class="article-card-image" href={url} aria-label={`Read ${article.data.title}`}>
      {image ? <img src={image} alt={imageAlt} title={article.data.featuredImageTitle || undefined} width="500" height="360" loading="lazy" decoding="async" /> : <span class="article-image-placeholder" aria-hidden="true">🐾</span>}
    </a>
    <div class="article-card-content">
      <h3><a href={url}>{article.data.title}</a></h3>
      <p>{description}</p>
    </div>
  </article>
)}
