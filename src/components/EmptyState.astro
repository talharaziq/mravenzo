---
const { title = 'No articles in this collection yet', text = 'Browse the full article library for more home, garden and plant ideas.' } = Astro.props;
---
<div class="empty-state">
  <span class="empty-state-mark" aria-hidden="true">🐾</span>
  <h3>{title}</h3>
  <p>{text}</p>
  <a class="text-link" href="/articles/">Browse all articles →</a>
</div>
