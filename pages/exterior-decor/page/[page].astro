---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import Pagination from '@/components/Pagination.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { getPublishedArticles, belongsToGroup } from '@/utils/content';
const pageSize = 12;
export async function getStaticPaths() {
  const pageSize = 12;
  const articles = (await getPublishedArticles()).filter((article) => belongsToGroup(article, 'exterior'));
  return Array.from({ length: Math.max(0, Math.ceil(articles.length / pageSize) - 1) }, (_, index) => ({ params: { page: String(index + 2) }, props: { currentPage: index + 2, articles } }));
}
const { currentPage, articles } = Astro.props;
const totalPages = Math.max(1, Math.ceil(articles.length / pageSize));
const pageArticles = articles.slice((currentPage - 1) * pageSize, currentPage * pageSize);
---
<BaseLayout title={`Exterior Decor — Page ${currentPage} | mravenzo.`} description={`Page ${currentPage} of garden decor and exterior living articles from mravenzo.`} keywords="garden decor, exterior decor, patio decor, deck decor, outdoor lighting, front yard decor">
  <section class="page-shell container"><Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Exterior Decor', href: '/exterior-decor/' }, { label: `Page ${currentPage}` }]} /><header class="archive-intro"><span class="eyebrow">Beyond the walls</span><h1>Make the outdoors yours.</h1><p>Ideas for gardens, patios, lighting and welcoming entrances.</p></header><div class="archive-tools"><span class="archive-count">Page {currentPage} of {totalPages}</span><span class="archive-count">12 articles per page</span></div><div class="archive-grid">{pageArticles.map((article) => <ArticleCard article={article} />)}</div><Pagination current={currentPage} total={totalPages} basePath="/exterior-decor/" /></section>
</BaseLayout>
